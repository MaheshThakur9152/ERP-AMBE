# ==============================================================================
# Enterprise Facility Management ERP — Environment Configuration Template
# ==============================================================================

# Node Environment ('development', 'test', 'production')
NODE_ENV=development
PORT=5000

# Client & CORS URLs (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_facility
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here

DATABASE_URL=postgresql://erp_admin:your_secure_postgres_password_here@localhost:5432/erp_facility

# Native JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_hmac_key_here

# ------------------------------------------------------------------------------
# Redis In-Memory Cache (Accelerated Read Layer, GATE-12)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3 / Oracle Object Storage)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=ambeuploads

# ------------------------------------------------------------------------------
# Disaster Recovery & Backup Encryption
# ------------------------------------------------------------------------------
GPG_PASSPHRASE=your_secure_backup_gpg_passphrase_here
REPLICATION_PASSWORD=your_secure_replication_password_here

# ------------------------------------------------------------------------------
# Optional Legacy Storage Fallbacks (GCP / Google Drive)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_BUCKET_NAME=ambe-erp-documents
DRIVE_EMPLOYEE_FOLDER_ID=
DRIVE_INVOICE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
